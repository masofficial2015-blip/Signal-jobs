# ==========================================
# Signal Job — Environment Configuration
# ==========================================
#
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file to git — it is already in .gitignore.
#
# For Railway: add each variable in the Railway project → Variables tab.
# ==========================================

# ── Runtime ───────────────────────────────────────────────────────────────────
# Must be "production" on Railway. Next.js sets this automatically,
# but it is good practice to set it explicitly.
NODE_ENV="production"

# ── Database ──────────────────────────────────────────────────────────────────
# Railway auto-populates DATABASE_URL when you attach a PostgreSQL plugin.
# Copy the "Postgres Connection URL" from Railway → your PostgreSQL service.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/railway?sslmode=require"

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# Get from @BotFather → /newbot or /mybots
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"

# Full public URL of your Railway app (e.g. https://signal-job.up.railway.app)
# The webhook will be registered at <TELEGRAM_WEBHOOK_URL>/api/telegram/webhook
TELEGRAM_WEBHOOK_URL="https://your-railway-app-name.up.railway.app/api/telegram/webhook"

# A random secret to validate that Telegram webhook requests are genuine.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET="generate_with_openssl_rand_hex_32"

# ── AI (Gemini) ───────────────────────────────────────────────────────────────
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-1.5-flash"

# ── Admin Dashboard ───────────────────────────────────────────────────────────
# Strong unique password for the admin login page.
ADMIN_PASSWORD="use_a_strong_unique_password_here"

# Random 32-char+ string used to sign JWT session tokens.
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET="generate_with_openssl_rand_hex_32"

# ── Public App URL ────────────────────────────────────────────────────────────
# The public-facing URL of your Railway deployment (same as TELEGRAM_WEBHOOK_URL base).
NEXT_PUBLIC_APP_URL="https://your-railway-app-name.up.railway.app"
